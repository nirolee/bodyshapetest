---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RatioCalculator from '../../../components/RatioCalculator.astro';
import References from '../../../components/References.astro';
import { refsFor } from '../../../lib/references.js';
import pct from '../../../data/whr_percentiles.json';
import c from '../../../content/pages-zh.json';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'zh-Hant', mainEntity: c.whr_faq.map(([q, a]: [string, string]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
const rowsF = [10, 25, 50, 75, 90].map((q) => [`${q}`, pct.whr.female[q - 1].toFixed(2), pct.whr.male[q - 1].toFixed(2)]);
---
<BaseLayout langs={['en', 'zh']} title={c.whr_title} description={c.whr_desc} jsonLd={jsonLd} lang="zh" bleed>
  <section class="band dark tight"><div class="wrap prose"><span class="eyebrow">{c.whr_eyebrow}</span><h1>{c.whr_h1}</h1><p class="lead" style="margin-top:14px">{c.whr_lead}</p></div></section>
  <section class="band"><div class="wrap"><RatioCalculator mode="whr" lang="zh" /></div></section>
  <section class="band warm"><div class="wrap prose">
    <h2>{c.whr_h2}</h2>
    <table class="gt"><thead><tr><th>{c.whr_cols[0]}</th><th>{c.whr_cols[1]}（n = {pct.n.female.toLocaleString()}）</th><th>{c.whr_cols[2]}（n = {pct.n.male.toLocaleString()}）</th></tr></thead><tbody>{rowsF.map(([p, f, m]) => <tr><td class="k">第 {p} 百分位</td><td>{f}</td><td>{m}</td></tr>)}</tbody></table>
    <p class="muted">{c.whr_note}</p>
    <p>{c.whr_tail}</p>
  </div></section>
  <References lang="zh" refs={refsFor('/waist-to-hip-ratio/')} />
  <section class="band"><div class="wrap prose"><span class="eyebrow">常見問題</span><h2>大家會問的</h2><div class="faq" style="margin-top:22px">{c.whr_faq.map(([q, a]: [string, string]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</BaseLayout>
