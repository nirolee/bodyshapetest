---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SUPPORT_EMAIL } from '../../../lib/site-config';
import c from '../../../content/pages-zh.json';
---
<BaseLayout langs={['en', 'zh']} title={c.terms_title} description={c.terms_desc} lang="zh" noindex>
  <h1>{c.terms_h1}</h1>
  {c.terms_paras.map((p: string) => <p set:html={p} />)}
  <p>{c.terms_q} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
  <p class="muted">{c.terms_updated}</p>
</BaseLayout>
