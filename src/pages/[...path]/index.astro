---
/** 指南／知識頁的動態路由。每個 src/content/guides/<key>.js 匯出 { path, en: {...} }，path 決定 URL。 */
import GuideLayout from '../../components/GuideLayout.astro';
import GuideBlocks from '../../components/GuideBlocks.astro';
const mods = import.meta.glob('../../content/guides/*.js', { eager: true });
const all = Object.values(mods).map((m: any) => m.default).filter((d: any) => d && d.path && d.en);
export function getStaticPaths() {
  const mods = import.meta.glob('../../content/guides/*.js', { eager: true });
  return Object.values(mods).map((m: any) => m.default).filter((d: any) => d && d.path && d.en)
    .map((d: any) => ({ params: { path: d.path.replace(/^\/|\/$/g, '') } }));
}
const { path } = Astro.params;
const mod = all.find((x: any) => x.path.replace(/^\/|\/$/g, '') === path)!;
const d = mod.en;
// 這一篇真的有哪幾語，就只發哪幾條 hreflang
const langs = (['en', 'zh'] as const).filter((l) => mod[l]);
---
<GuideLayout lang="en" langs={langs} title={d.meta.title} description={d.meta.description}
  eyebrow={d.layout.eyebrow} h1={d.layout.h1} lead={d.layout.lead}
  faq={d.faq} ctaHead={d.layout.ctaHead} ctaNote={d.layout.ctaNote} updated={d.layout.updated} tool={d.layout.tool ?? 'women'}>
  <GuideBlocks blocks={d.blocks} tableKey={null} tableData={d.tableData ?? null} lang="en" />
</GuideLayout>
